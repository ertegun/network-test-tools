    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@iconify-icons/material-symbols": "2.0.6",
    "@iconify/react": "6.0.2",
    "@material-tailwind/react": "2.1.10",
    "i18next": "26.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
