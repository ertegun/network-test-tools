{
  "name": "netkit",
  "version": "0.1.0",
  "private": true,
  "description": "NetKit — çapraz platform masaüstü ağ test ve yönetim aracı",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
